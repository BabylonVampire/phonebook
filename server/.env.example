# Для запуска сервера без Docker (npm run dev / npm start).
# По умолчанию указывает на PostgreSQL из docker compose (порт 5433):
#   docker compose up -d db
# База phonebook, таблицы и моковые данные создаются автоматически при первом запуске.
PGHOST=localhost
PGPORT=5433
PGDATABASE=phonebook
PGUSER=phonebook
PGPASSWORD=phonebook
PORT=3000
